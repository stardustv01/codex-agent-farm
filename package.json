{
  "name": "codex-agent-farm",
  "version": "0.1.1",
  "description": "Local-only Agent Farm hierarchy monitor for Codex",
  "license": "Apache-2.0",
  "keywords": [
    "codex",
    "agent",
    "subagent",
    "monitoring",
    "local"
  ],
  "os": [
    "darwin"
  ],
  "type": "module",
  "bin": {
    "agent-farm": "bin/agent-farm.mjs"
  },
  "files": [
    "bin/agent-farm.mjs",
    "release/runtime/**",
    "web/dist/mcp-resource.html",
    "web/dist/mcp-resource.json",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "setup": "node scripts/configure-local.mjs",
    "start:local": "node scripts/start-local.mjs",
    "doctor:local": "node scripts/doctor-local.mjs",
    "reset:local": "node scripts/cleanup-local.mjs --reset",
    "uninstall:local": "node scripts/cleanup-local.mjs --uninstall",
    "build": "pnpm -r --filter '!@agent-farm/web' run build && pnpm --filter @agent-farm/web run build:mcp && node scripts/write-build-manifest.mjs",
    "build:release": "pnpm build && node scripts/build-release.mjs",
    "pack:release": "pnpm build:release && npm pack",
    "check:privacy": "node evidence/phase-f/check-private-source-ids.mjs",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test && pnpm test:integration && pnpm test:external-acceptance",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:external-acceptance": "node --import tsx --test evidence/phase-e/validate-external-acceptance.test.mts",
    "check:production-preflight": "node --import tsx evidence/phase-e/production-preflight.mts",
    "check": "pnpm check:privacy && pnpm typecheck && pnpm test && pnpm build && pnpm check:production-preflight",
    "dev": "pnpm --parallel --filter @agent-farm/server --filter @agent-farm/web dev"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "esbuild": "0.28.1",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
